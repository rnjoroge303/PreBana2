<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#ad5b78">
    <title>Create admin account | PreBana Cosmetics</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&amp;family=Manrope:wght@500;600;700;800&amp;display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/styles/css/auth.css">
</head>
<body class="authPage adminAuth">
    <main class="authShell">
        <section class="authVisual" aria-label="PreBana admin">
            <a class="authBrand" href="/pre/admin" aria-label="PreBana Cosmetics admin">
                <img class="authBrandLogo" src="/uploads/logo/preLogo.jpeg" alt="PreBana Cosmetics">
            </a>
            <div class="authVisualCopy"><p>PREBANA COSMETICS</p><h1>Thoughtful care.<br>Thoughtful business.</h1><span>Create authorized access to your store.</span></div>
            <span class="authVisualFoot">ADMINISTRATOR ACCESS <span aria-hidden="true">·</span> NAIROBI</span>
        </section>
        <section class="authFormPanel">
            <a class="authBack" href="/pre/admin">← Back to dashboard</a>
            <div class="authFormWrap">
                <p class="authEyebrow">ADMINISTRATOR ACCESS</p>
                <h2>Add an administrator.</h2>
                <p class="authIntro">This page is available only to a signed-in administrator.</p>
                <% if (error) { %><p class="authError" role="alert"><%= error %></p><% } %>
                <form class="authForm" action="/pre/admin/signup" method="post">
                    <label for="email">Admin email</label>
                    <input id="email" name="email" type="email" autocomplete="username" required placeholder="admin@example.com">
                    <label for="password">Password</label>
                    <input id="password" name="password" type="password" autocomplete="new-password" minlength="12" required placeholder="At least 12 characters">
                    <label for="confirmPassword">Confirm password</label>
                    <input id="confirmPassword" name="confirmPassword" type="password" autocomplete="new-password" minlength="12" required placeholder="Enter the password again">
                    <button class="authSubmit" type="submit">Create admin account <span aria-hidden="true">→</span></button>
                </form>
            </div>
            <footer class="authFooter">Secure store management.</footer>
        </section>
    </main>
</body>
</html>
