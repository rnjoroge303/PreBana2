<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Payment Receipt</title>
    <style>
        body {
            max-width: 680px;
            margin: 40px auto;
            padding: 24px;
            font-family: Arial, sans-serif;
            color: #54283d;
        }

        .receipt {
            border: 1px solid #efb4ce;
            border-radius: 16px;
            padding: 28px;
        }

        h1 {
            color: #c92f75;
        }

        .row {
            display: flex;
            justify-content: space-between;
            gap: 20px;
            padding: 10px 0;
            border-bottom: 1px solid #f5d6e3;
        }

        .amount {
            font-size: 1.5rem;
            font-weight: bold;
            color: #c92f75;
        }

        button {
            padding: 12px 20px;
            border: 0;
            border-radius: 999px;
            background: #c92f75;
            color: white;
            font: inherit;
            cursor: pointer;
        }

        .actions {
            display: flex;
            gap: 12px;
        }

        .actions a {
            display: inline-block;
            margin-top: 20px;
            padding: 12px 20px;
            border-radius: 999px;
            background: #c92f75;
            color: white;
            font: inherit;
            text-decoration: none;
        }

        @media print {
            .actions {
                display: none;
            }

            body {
                margin: 0;
            }
        }
    </style>
</head>

<body>
    <div class="receipt">
        <h1>M-Pesa Payment Receipt</h1>
        <div class="row"><span>Status</span><strong><%= receipt.status === "confirmed" ? "Confirmed" : "Pending" %></strong></div>
        <div class="row"><span>Receipt number</span><strong><%= receipt.mpesa_receipt || "Pending" %></strong></div>
        <div class="row"><span>Phone number</span><strong><%= receipt.phone_number || "" %></strong></div>
        <div class="row"><span>Recipient</span><strong><%= receipt.order_recipient_name || receipt.recipient_name || "" %></strong></div>
        <div class="row"><span>Delivery location</span><strong><%= receipt.order_shipping_location || receipt.shipping_location || "" %></strong></div>
        <div class="row"><span>Amount</span><strong class="amount">Ksh <%= Number(receipt.amount || 0).toFixed(2) %></strong></div>
        <div class="row"><span>Order ID</span><strong><%= receipt.order_id || "" %></strong></div>
        <div class="row"><span>Product ID</span><strong><%= receipt.product_id || "" %></strong></div>
        <div class="row"><span>Quantity</span><strong><%= receipt.quantity || "" %></strong></div>
    </div>
    <div class="actions">
        <button type="button" onclick="window.print()">Print invoice</button>
        <% if (receipt.checkout_request_id) { %>
            <a href="/invoice/<%= encodeURIComponent(receipt.checkout_request_id) %>.pdf">Download PDF</a>
        <% } else { %>
            <button type="button" disabled>Download PDF</button>
        <% } %>
    </div>
</body>

</html>