<!doctype html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Shop thoughtful everyday skincare and beauty essentials from PreBana Cosmetics.">
    <meta name="theme-color" content="#ad5b78">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="/styles/css/main.css">
    <link rel="stylesheet" href="/styles/css/product.css">
    <title>PreBana Cosmetics | Everyday beauty, thoughtfully chosen</title>
</head>

<body>
    <div class="announcement">
        <span>Beauty for the everyday, and everything in between.</span>
        <span class="announcementNote">PREBANA COSMETICS <span aria-hidden="true">·</span> NAIROBI</span>
    </div>
    <div class="storeLayout">
        <div class="sideBar">
            <a class="logo" href="/pre/store" aria-label="PreBana Cosmetics home">
                <span class="brandMark" aria-hidden="true">P</span>
                <span class="brandText"><strong>PreBana</strong><small>BOTANICAL BEAUTY</small></span>
            </a>
            <div class="sidebarLabel">DISCOVER</div>
            <nav class="cgs" aria-label="Product categories">
                <button class="cg" type="button" data-category="all" aria-pressed="true">All products</button>
                <button class="cg" type="button" data-category="hair" aria-pressed="false">Hair care</button>
                <button class="cg" type="button" data-category="face" aria-pressed="false">Face care</button>
                <button class="cg" type="button" data-category="body" aria-pressed="false">Body care</button>
                <button class="cg" type="button" data-category="baby" aria-pressed="false">Baby care</button>
                <button class="cg" type="button" data-category="nails" aria-pressed="false">Nails</button>
                <button class="cg" type="button" data-category="mens" aria-pressed="false">Men's care</button>
            </nav>
            <div class="sidebarNote">
                <span class="sidebarNoteMark" aria-hidden="true">✳</span>
                <p>Small rituals.<br><strong>Feel-good days.</strong></p>
            </div>
            <div class="sidebarFoot">A little care goes a long way.</div>
        </div>
        <div class="main">
            <div class="topNav">
                <label class="searchBox" for="searchProducts">
                    <span class="srOnly">Search products</span>
                    <svg aria-hidden="true" viewBox="0 0 24 24">
                        <circle cx="11" cy="11" r="7"></circle>
                        <path d="m16 16 4 4"></path>
                    </svg>
                    <input id="searchProducts" type="search" placeholder="Search products">
                </label>
                <label class="filterBox">
                    <span class="srOnly">Filter products</span>
                    <select id="filterCategory" aria-label="Filter products">
                        <option value="all">All products</option>
                        <option value="featured">Featured</option>
                        <option value="hair">Hair Care</option>
                        <option value="face">Face Care</option>
                        <option value="body">Body Care</option>
                        <option value="baby">Baby Care</option>
                        <option value="nails">Nails</option>
                        <option value="mens">Men's Care</option>
                    </select>
                </label>
                <div class="navActions">
                    <button class="navAction accountAction" id="myOrdersButton" type="button" aria-label="My orders"
                        title="My orders">
                        <svg aria-hidden="true" viewBox="0 0 24 24">
                            <circle cx="12" cy="8" r="4"></circle>
                            <path d="M4 21a8 8 0 0 1 16 0"></path>
                        </svg>
                        <span>My orders</span>
                    </button>
                    <form class="clientLogoutForm" action="/pre/logout" method="post"><input type="hidden" name="role"
                            value="client"><button class="navAction logoutAction" type="submit" aria-label="Sign out"
                            title="Sign out">
                            <svg aria-hidden="true" viewBox="0 0 24 24">
                                <path d="M10 17l5-5-5-5M15 12H3"></path>
                                <path d="M12 3h6a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-6"></path>
                            </svg>
                        </button></form>
                    <button class="navAction cartAction" id="cartButton" type="button"
                        aria-label="Shopping bag, 0 items">
                        <svg aria-hidden="true" viewBox="0 0 24 24">
                            <path d="M3 4h2l2.2 11.2a2 2 0 0 0 2 1.6h8.5a2 2 0 0 0 2-1.6L21 8H6"></path>
                            <circle cx="10" cy="20" r="1"></circle>
                            <circle cx="18" cy="20" r="1"></circle>
                        </svg>
                        <span class="cartLabel">Bag</span>
                        <span class="cartCount" id="cartCount">0</span>
                    </button>
                </div>
            </div>
            <main class="storefront">
                <section class="hero" aria-labelledby="heroTitle">
                    <div class="heroCopy">
                        <p class="eyebrow"><span class="eyebrowLine"></span> YOUR EVERYDAY, ELEVATED</p>
                        <h1 id="heroTitle">A softer kind<br>of <em>self-care.</em></h1>
                        <p class="heroDescription">Thoughtful beauty essentials for the little rituals that make a day
                            feel like yours.</p>
                        <a class="heroCta" href="#collection">Explore the collection
                            <svg aria-hidden="true" viewBox="0 0 24 24">
                                <path d="M5 12h14m-6-6 6 6-6 6"></path>
                            </svg>
                        </a>
                        <div class="heroFootnote"><span class="heroFootnoteDot"></span> Made for real life, and all the
                            moments in it.</div>
                    </div>
                    <div class="heroVisual">
                        <img src="https://images.unsplash.com/photo-1608248543803-ba4f8c70ae0b?auto=format&amp;fit=crop&amp;w=1400&amp;q=85"
                            alt="A curated collection of skincare essentials" fetchpriority="high">
                        <div class="heroImageTag"><span>THE PREBANA EDIT</span><strong>Find your feel-good.</strong>
                        </div>
                        <span class="heroImageIndex" aria-hidden="true">01 / 07</span>
                    </div>
                </section>
                <section class="collection" id="collection" aria-labelledby="collectionTitle">
                    <div class="collectionHead">
                        <div>
                            <p class="eyebrow"><span class="eyebrowLine"></span> THE GOOD STUFF</p>
                            <h2 id="collectionTitle">A daily dose of lovely.</h2>
                        </div>
                        <p class="collectionIntro">Simple favorites, picked with care.<br>Find the one that feels like
                            you.</p>
                    </div>
                    <div class="collectionToolbar">
                        <h3 class="ca" id="categoryTitle">All products</h3>
                        <p class="productCount" id="productCount" aria-live="polite">
                            <%= products.length %>
                                <%= products.length===1 ? "product" : "products" %>
                        </p>
                    </div>
                    <div class="mainCo" id="productGrid">
                        <% products.forEach((product)=> { %>
                            <%- include("includes/productCard", { product }) %>
                                <% }); %>
                    </div>
                    <p class="emptyState" id="emptyState" <%=products.length ? "hidden" : "" %>>No products found. Try
                        another search.</p>
                </section>
                <section class="orderHistory" id="orders" aria-labelledby="ordersTitle" hidden>
                    <div class="orderHistoryHeading">
                        <div>
                            <p class="eyebrow"><span class="eyebrowLine"></span> YOUR ACCOUNT</p>
                            <h2 id="ordersTitle">My orders</h2>
                            <p>Order details, delivery information, and payment verification.</p>
                        </div>
                        <button class="orderHistoryClose" id="closeOrdersButton" type="button">Back to shopping</button>
                    </div>
                    <p class="orderHistoryFeedback" id="ordersFeedback" role="status" aria-live="polite"></p>
                    <div class="orderHistoryList" id="ordersList"></div>
                </section>
                <footer class="storeFooter">
                    <span>PREBANA COSMETICS</span>
                    <span>Everyday beauty, thoughtfully chosen.</span>
                </footer>
            </main>
        </div>
    </div>
    <div class="toast" id="toast" role="status" aria-live="polite" hidden></div>
    <script>
        const searchInput = document.getElementById("searchProducts");
        const categoryFilter = document.getElementById("filterCategory");
        const categoryTitle = document.getElementById("categoryTitle");
        const categoryButtons = document.querySelectorAll(".cg[data-category]");
        const productSections = document.querySelectorAll(".category-section");
        const productCount = document.getElementById("productCount");
        const emptyState = document.getElementById("emptyState");
        const cartCount = document.getElementById("cartCount");
        const cartButton = document.getElementById("cartButton");
        const myOrdersButton = document.getElementById("myOrdersButton");
        const closeOrdersButton = document.getElementById("closeOrdersButton");
        const ordersSection = document.getElementById("orders");
        const ordersList = document.getElementById("ordersList");
        const ordersFeedback = document.getElementById("ordersFeedback");
        const toast = document.getElementById("toast");
        const cartStorageKey = "prebanaCart";
        let cartItems = [];
        let toastTimer;
        try {
            const savedCart = JSON.parse(window.localStorage.getItem(cartStorageKey) || "[]");
            cartItems = Array.isArray(savedCart) ? savedCart.filter((item) => item.productId && Number.isInteger(item.quantity) && item.quantity > 0) : [];
        } catch {
            cartItems = [];
        }

        function updateCartCount() {
            const itemCount = cartItems.reduce((total, item) => total + item.quantity, 0);
            cartCount.textContent = itemCount;
            cartButton.setAttribute("aria-label", `Shopping bag, ${itemCount} ${itemCount === 1 ? "item" : "items"}`);
            window.localStorage.setItem(cartStorageKey, JSON.stringify(cartItems));
        }

        updateCartCount();

        function filterProducts() {
            const query = searchInput.value.trim().toLowerCase();
            const category = categoryFilter.value;
            categoryTitle.textContent = query
                ? `Search results for "${searchInput.value.trim()}"`
                : categoryFilter.selectedOptions[0].textContent;

            categoryButtons.forEach((button) => {
                button.setAttribute("aria-pressed", String(button.dataset.category === category));
            });

            let visibleCount = 0;
            productSections.forEach((section) => {
                const products = section.querySelectorAll(".product");
                let hasVisibleProduct = false;

                products.forEach((product) => {
                    const matchesQuery = product.textContent.toLowerCase().includes(query);
                    const matchesCategory = category === "all" || product.dataset.category === category;
                    product.hidden = !matchesQuery || !matchesCategory;
                    hasVisibleProduct ||= matchesQuery && matchesCategory;
                    visibleCount += matchesQuery && matchesCategory ? 1 : 0;
                });

                section.hidden = !hasVisibleProduct;
            });

            productCount.textContent = `${visibleCount} ${visibleCount === 1 ? "product" : "products"}`;
            emptyState.hidden = visibleCount > 0;
        }

        function showToast(message) {
            toast.textContent = message;
            toast.hidden = false;
            window.clearTimeout(toastTimer);
            toastTimer = window.setTimeout(() => {
                toast.hidden = true;
            }, 2600);
        }

        searchInput.addEventListener("input", () => {
            categoryFilter.value = "all";
            filterProducts();
        });
        categoryFilter.addEventListener("change", () => {
            searchInput.value = "";
            filterProducts();
        });
        categoryButtons.forEach((button) => {
            button.addEventListener("click", () => {
                searchInput.value = "";
                categoryFilter.value = button.dataset.category;
                filterProducts();
            });
        });

        document.querySelectorAll("[data-add-to-bag]").forEach((button) => {
            button.addEventListener("click", () => {
                const productCard = button.closest(".product[data-product-id]");
                const productId = productCard?.dataset.productId;
                if (!productId) {
                    showToast("This product could not be added right now.");
                    return;
                }
                const cartItem = cartItems.find((item) => item.productId === productId);
                if (cartItem) {
                    cartItem.quantity += 1;
                } else {
                    cartItems.push({ productId, quantity: 1 });
                }
                updateCartCount();
                showToast(`${button.dataset.productName} added to your bag.`);
            });
        });

        document.querySelectorAll(".productGallery[data-gallery-images]").forEach((gallery) => {
            let images;
            try {
                images = JSON.parse(gallery.dataset.galleryImages);
            } catch {
                return;
            }
            if (!Array.isArray(images) || images.length < 2) {
                return;
            }

            const image = gallery.querySelector(".productGalleryImage");
            const imageCount = gallery.querySelector(".productImageCount");
            let activeImage = 0;

            gallery.querySelectorAll("[data-gallery-step]").forEach((button) => {
                button.addEventListener("click", () => {
                    activeImage = (activeImage + Number(button.dataset.galleryStep) + images.length) % images.length;
                    image.src = images[activeImage].url;
                    image.alt = images[activeImage].alt || image.alt;
                    imageCount.textContent = `${activeImage + 1} / ${images.length}`;
                });
            });
        });

        document.querySelectorAll(".wishlist").forEach((button) => {
            button.addEventListener("click", () => {
                const saved = button.getAttribute("aria-pressed") !== "true";
                button.setAttribute("aria-pressed", String(saved));
                showToast(saved ? "Added to your wishlist." : "Removed from your wishlist.");
            });
        });

        cartButton.addEventListener("click", () => {
            if (cartItems.length) {
                window.location.href = "/pre/checkout";
                return;
            }
            showToast("Your bag is empty for now.");
        });

        function formatOrderDate(value) {
            const date = new Date(value);
            return Number.isNaN(date.getTime()) ? "Date unavailable" : date.toLocaleString("en-KE", { dateStyle: "medium", timeStyle: "short" });
        }

        function appendOrderText(parent, label, value) {
            const line = document.createElement("p");
            const title = document.createElement("strong");
            title.textContent = `${label}: `;
            line.append(title, document.createTextNode(value || "Not provided"));
            parent.append(line);
        }

        function renderOrder(order) {
            const card = document.createElement("article");
            const heading = document.createElement("div");
            const orderId = document.createElement("h3");
            const date = document.createElement("time");
            const status = document.createElement("span");
            const details = document.createElement("div");
            const itemList = document.createElement("ul");
            const total = document.createElement("p");
            const paymentLabels = {
                paid: "Paid",
                pending: "M-Pesa prompt sent or awaiting payment",
                awaiting_verification: "Waiting for store verification",
                failed: "Payment failed — retry or submit a code",
                cancelled: "Payment cancelled — retry or submit a code",
                review_required: "Payment received — store review required"
            };
            const paymentStatus = paymentLabels[order.paymentStatus] || "Payment pending";

            card.className = "orderHistoryCard";
            card.dataset.orderId = order.id;
            heading.className = "orderHistoryCardHeading";
            orderId.textContent = `Order ${order.id}`;
            date.dateTime = order.createdAt || "";
            date.textContent = formatOrderDate(order.createdAt);
            status.className = `orderHistoryStatus ${order.paymentStatus === "paid" ? "isPaid" : order.paymentStatus === "awaiting_verification" ? "isWaiting" : ""}`;
            status.textContent = paymentStatus;
            heading.append(orderId, date, status);
            details.className = "orderHistoryDetails";
            appendOrderText(details, "Delivery address", order.customer?.address);
            appendOrderText(details, "Phone", order.customer?.phone);
            appendOrderText(details, "Email", order.customer?.email);
            appendOrderText(details, "Order status", order.status || "received");
            if (order.paymentReference) {
                appendOrderText(details, "M-Pesa receipt / code", order.paymentReference);
            }
            if (order.note) {
                appendOrderText(details, "Order note", order.note);
            }
            itemList.className = "orderHistoryItems";
            (Array.isArray(order.items) ? order.items : []).forEach((item) => {
                const listItem = document.createElement("li");
                listItem.textContent = `${item.name} × ${item.quantity} — KSh ${Number(item.lineTotal || 0).toLocaleString("en-KE")}`;
                itemList.append(listItem);
            });
            total.className = "orderHistoryTotal";
            total.textContent = `Total: KSh ${Number(order.total || 0).toLocaleString("en-KE")}`;
            card.append(heading, details, itemList, total);

            if (order.paymentStatus === "paid") {
                const receiptActions = document.createElement("div");
                const printReceipt = document.createElement("a");
                const downloadReceipt = document.createElement("a");
                const receiptPath = `/pre/orders/${encodeURIComponent(order.id)}/receipt`;
                receiptActions.className = "orderReceiptActions";
                printReceipt.href = receiptPath;
                printReceipt.target = "_blank";
                printReceipt.rel = "noopener";
                printReceipt.textContent = "Print thermal receipt";
                downloadReceipt.href = `${receiptPath}.pdf`;
                downloadReceipt.textContent = "Download PDF";
                receiptActions.append(printReceipt, downloadReceipt);
                card.append(receiptActions);
            } else {
                const stkForm = document.createElement("form");
                const stkLabel = document.createElement("label");
                const stkPhone = document.createElement("input");
                const stkButton = document.createElement("button");
                stkForm.className = "orderPaymentForm";
                stkLabel.textContent = "Phone to receive an M-Pesa prompt";
                stkPhone.type = "tel";
                stkPhone.value = order.paymentPhone || order.customer?.phone || "";
                stkPhone.required = true;
                stkPhone.autocomplete = "tel";
                stkButton.type = "submit";
                stkButton.textContent = "Send STK prompt";
                stkForm.append(stkLabel, stkPhone, stkButton);
                stkForm.addEventListener("submit", async (event) => {
                    event.preventDefault();
                    stkButton.disabled = true;
                    stkButton.textContent = "Sending...";
                    try {
                        const response = await fetch(`/pre/orders/${encodeURIComponent(order.id)}/mpesa`, {
                            method: "POST",
                            headers: { "Content-Type": "application/json" },
                            body: JSON.stringify({ phoneNumber: stkPhone.value })
                        });
                        const result = await response.json();
                        if (!response.ok) {
                            throw new Error(result.error || "The M-Pesa prompt could not be sent.");
                        }
                        ordersFeedback.textContent = "M-Pesa prompt sent. Approve it on your phone; your order will update after confirmation.";
                        stkButton.textContent = "Prompt sent";
                    } catch (error) {
                        ordersFeedback.textContent = error.message;
                        stkButton.disabled = false;
                        stkButton.textContent = "Send STK prompt";
                    }
                });
                card.append(stkForm);

                const form = document.createElement("form");
                const label = document.createElement("label");
                const input = document.createElement("input");
                const submit = document.createElement("button");
                const error = document.createElement("p");
                form.className = "orderPaymentForm";
                label.textContent = "Check your M-Pesa transaction code";
                input.name = "paymentReference";
                input.required = true;
                input.maxLength = 20;
                input.autocomplete = "off";
                input.placeholder = "e.g. QGH7X2ABC1";
                submit.type = "submit";
                submit.textContent = "Confirm M-Pesa code";
                error.className = "orderPaymentError";
                error.hidden = true;
                form.append(label, input, submit, error);
                form.addEventListener("submit", async (event) => {
                    event.preventDefault();
                    error.hidden = true;
                    submit.disabled = true;
                    submit.textContent = "Submitting...";
                    try {
                        const response = await fetch(`/pre/orders/${encodeURIComponent(order.id)}/mpesa-confirmation`, {
                            method: "POST",
                            headers: { "Content-Type": "application/json" },
                            body: JSON.stringify({ paymentReference: input.value })
                        });
                        const result = await response.json();
                        if (!response.ok) {
                            throw new Error(result.error || "Payment confirmation could not be submitted.");
                        }
                        window.location.href = `/pre/orders/${encodeURIComponent(order.id)}/receipt`;
                    } catch (requestError) {
                        error.textContent = requestError.message;
                        error.hidden = false;
                        submit.disabled = false;
                        submit.textContent = "Confirm M-Pesa code";
                    }
                });
                card.append(form);
            }
            return card;
        }

        async function loadOrders() {
            ordersFeedback.textContent = "Loading your orders...";
            ordersList.replaceChildren();
            try {
                const response = await fetch("/pre/orders", { cache: "no-store" });
                const result = await response.json();
                if (!response.ok) {
                    throw new Error(result.error || "Your orders could not be loaded.");
                }
                const orders = Array.isArray(result.orders) ? result.orders : [];
                ordersFeedback.textContent = orders.length ? "" : "You have not placed any orders yet.";
                orders.forEach((order) => ordersList.append(renderOrder(order)));
            } catch (error) {
                ordersFeedback.textContent = error.message;
            }
        }

        let ordersNeedRefresh = false;
        async function refreshOrderPaymentStatuses() {
            if (ordersSection.hidden || document.hidden) return;
            try {
                const response = await fetch("/pre/orders", { cache: "no-store" });
                if (!response.ok) return;
                const result = await response.json();
                const renderedStatuses = new Map(
                    [...ordersList.querySelectorAll(".orderHistoryCard")]
                        .map((card) => [card.dataset.orderId, card.querySelector(".orderHistoryStatus")?.textContent])
                );
                const statusLabels = {
                    paid: "Paid",
                    pending: "M-Pesa prompt sent or awaiting payment",
                    awaiting_verification: "Waiting for store verification",
                    failed: "Payment failed — retry or submit a code",
                    cancelled: "Payment cancelled — retry or submit a code",
                    review_required: "Payment received — store review required"
                };
                ordersNeedRefresh = (result.orders || []).some((order) =>
                    renderedStatuses.has(order.id)
                    && renderedStatuses.get(order.id) !== (statusLabels[order.paymentStatus] || "Payment pending")
                );
                if (ordersNeedRefresh && !ordersList.contains(document.activeElement)) {
                    ordersNeedRefresh = false;
                    await loadOrders();
                }
            } catch (error) {
                console.warn("Could not refresh order payment statuses:", error);
            }
        }

        window.setInterval(refreshOrderPaymentStatuses, 5000);

        function openOrders() {
            ordersSection.hidden = false;
            window.location.hash = "orders";
            ordersSection.scrollIntoView({ behavior: "smooth", block: "start" });
            loadOrders();
        }

        myOrdersButton.addEventListener("click", openOrders);
        closeOrdersButton.addEventListener("click", () => {
            ordersSection.hidden = true;
            history.replaceState(null, "", `${window.location.pathname}${window.location.search}`);
            document.getElementById("collection").scrollIntoView({ behavior: "smooth", block: "start" });
        });
        if (window.location.hash === "#orders") {
            ordersSection.hidden = false;
            loadOrders();
            window.requestAnimationFrame(() => ordersSection.scrollIntoView({ block: "start" }));
        }
    </script>
</body>

</html>