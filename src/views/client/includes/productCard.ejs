<% const productImages = Array.isArray(product.images) ? product.images : []; %>
<% const categoryNames = { featured: "Featured", hair: "Hair care", face: "Face care", body: "Body care", baby: "Baby care", nails: "Nail care", mens: "Men's care" }; %>
<div class="category-section">
    <article class="product" data-product-id="<%= product.id %>" data-category="<%= product.category %>">
        <div class="productMedia">
            <% if (productImages.length) { %>
                <div class="productGallery" data-gallery-images="<%= JSON.stringify(productImages) %>">
                    <img class="productGalleryImage" src="<%= productImages[0].url %>" alt="<%= productImages[0].alt || product.name %>" loading="lazy">
                    <% if (productImages.length > 1) { %>
                        <button class="galleryArrow galleryPrevious" type="button" data-gallery-step="-1" aria-label="Previous image of <%= product.name %>">
                            <svg aria-hidden="true" viewBox="0 0 24 24"><path d="m15 18-6-6 6-6"></path></svg>
                        </button>
                        <button class="galleryArrow galleryNext" type="button" data-gallery-step="1" aria-label="Next image of <%= product.name %>">
                            <svg aria-hidden="true" viewBox="0 0 24 24"><path d="m9 18 6-6-6-6"></path></svg>
                        </button>
                        <span class="productImageCount" aria-live="polite">1 / <%= productImages.length %></span>
                    <% } %>
                </div>
            <% } else { %>
                <div class="productImageFallback" aria-label="No product image available"><span>PREBANA</span></div>
            <% } %>
            <span class="productBadge"><%= categoryNames[product.category] || "Beauty" %></span>
            <button class="wishlist" type="button" aria-label="Save <%= product.name %> to wishlist" aria-pressed="false">
                <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8l1.1 1.1L12 21l7.8-7.5 1.1-1.1a5.5 5.5 0 0 0-.1-7.8Z"></path></svg>
            </button>
        </div>
        <div class="productInfo">
            <p class="productCategory"><%= categoryNames[product.category] || "Beauty" %></p>
            <h3 class="pname"><%= product.name %></h3>
            <p class="desc"><%= product.description || "Thoughtfully chosen for your everyday routine." %></p>
            <div class="productBottom">
                <p class="pprice">Ksh <%= Number(product.price).toLocaleString("en-KE") %></p>
                <button class="addToBag" type="button" data-add-to-bag data-product-name="<%= product.name %>" aria-label="Add <%= product.name %> to bag">
                    <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M5 7h14l-1.2 13H6.2L5 7Z"></path><path d="M9 9V6a3 3 0 0 1 6 0v3"></path></svg>
                    <span>Add to bag</span>
                </button>
            </div>
        </div>
    </article>
</div>
