# Required in Vercel Project Settings > Environment Variables
NODE_ENV=production
JWT_SECRET=replace-with-a-long-random-secret
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORT_CODE=
MPESA_TILL_NUMBER=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://your-deployment-domain/api/mpesa/callback

# Required only if/when the app is migrated to use the MySQL adapter
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=
