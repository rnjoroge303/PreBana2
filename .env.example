# Required in Vercel Project Settings > Environment Variables
NODE_ENV=production
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=
ADMIN_PASSWORD=
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORT_CODE=
MPESA_TILL_NUMBER=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://pre-bana2.vercel.app/api/mpesa/callback
# Optional when local development is not using Vercel OIDC
BLOB_READ_WRITE_TOKEN=

